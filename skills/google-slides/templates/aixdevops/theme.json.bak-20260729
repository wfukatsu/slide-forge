{
  "name": "aixdevops",
  "displayName": "AI x DevOps Study Theme",
  "version": "1.0.0",
  "description": "AI x DevOps Study 向けテーマ。Deep Purple / Cyan 基調のテック系パレット",
  "source": null,

  "pageSize": {
    "width": 9144000,
    "height": 5143500,
    "widthInches": 10.0,
    "heightInches": 5.625,
    "aspectRatio": "16:9",
    "unit": "EMU"
  },

  "colors": {
    "__comment": "=== Theme Colors (Purple/Cyan tech palette) ===",
    "dark1":               "#1E1033",
    "light1":              "#FFFFFF",
    "dark2":               "#6B7280",
    "light2":              "#F5F3FF",
    "accent1":             "#06B6D4",
    "accent2":             "#EC4899",
    "accent3":             "#8B5CF6",
    "accent4":             "#F59E0B",
    "accent5":             "#5B21B6",
    "accent6":             "#5B21B6",

    "__comment_semantic": "=== Semantic Aliases ===",
    "primary":             "#5B21B6",
    "primaryDark":         "#3B0764",
    "accent":              "#06B6D4",
    "success":             "#10B981",
    "textPrimary":         "#000000",
    "textTitle":           "#3B0764",
    "textOnDark":          "#FFFFFF",
    "textMuted":           "#666666",
    "__textMuted_note":    "Changed from #808080 to #666666 for WCAG AA compliance (4.5:1 contrast ratio on white background). Original #808080 only achieves 3.9:1.",
    "textSecondary":       "#595959",
    "background":          "#FFFFFF",
    "backgroundAlt":       "#F5F3FF",
    "surfaceLight":        "#EDE9FE",
    "border":              "#6B7280",
    "calloutBg":           "#EDE9FE",
    "calloutBorder":       "#5B21B6",
    "cautionDark":         "#6B5000",

    "__comment_table": "=== Table Colors ===",
    "tableHeader":         "#5B21B6",
    "tableHeaderText":     "#FFFFFF",
    "tableDataCell":       "#EDE9FE",
    "tableRowHeader":      "#DDD6FE",
    "tableRowAlt":         "#EEEEEE",

    "__comment_semantic_fills": "=== Status Colors ===",
    "highlightYellow":     "#FFF1CC",
    "successGreen":        "#D1FAE5",
    "successGreenDark":    "#059669",
    "alertRed":            "#F4CCCC",
    "cautionYellow":       "#BE9000",

    "__comment_chart": "=== Chart Colors (accent order) ===",
    "chart1":              "#06B6D4",
    "chart2":              "#8B5CF6",
    "chart3":              "#EC4899",
    "chart4":              "#F59E0B",
    "chart5":              "#5B21B6"
  },

  "fonts": {
    "fontFaceTitle":       "Noto Sans JP",
    "fontFaceBody":        "Noto Sans JP",
    "fontFaceEn":          "Arial",
    "fontFaceMono":        "Courier New",
    "fontFaceAccent":      "Century Gothic",
    "fontFallback":        "Noto Sans JP, Arial"
  },

  "fontSizes": {
    "__comment": "=== Master-level defaults ===",
    "coverTitle":          30,
    "contentTitle":        26,
    "sectionTitle":        24,
    "masterTitle":         20,
    "bodyLevel1":          16,
    "bodyLevel2":          14,
    "bodyLevel3":          12,
    "bodyLevel4":          10,
    "bodyLevel5":          8,
    "__bodyLevel5_note":   "8pt はマスターレベルの最小値。インフォグラフィクスでは 9pt 以上必須、10pt 以上推奨（infographic-patterns.md 参照）",
    "slideNumber":         7,
    "copyright":           7,

    "__comment_actual": "=== Actual slide-level common sizes ===",
    "bodyTextPrimary":     10,
    "bodyTextSecondary":   12,
    "bodyTextSmall":       8,
    "bodyTextCompact":     9,
    "subtitle":            14,
    "finePrint":           7,
    "__finePrint_note":    "Changed from 6 to 7 to meet minimum footer font size (7pt). design-principles.md セクション8参照"
  },

  "fontWeights": {
    "title":               "bold",
    "body":                "normal"
  },

  "lineSpacing": {
    "__comment": "Google Slides API lineSpacing はパーセント値（100=1行分）。日本語本文はこの値を 185-200 に上書きすること（design-principles.md セクション2参照）",
    "title":               100,
    "body":                115,
    "bodyJapanese":        185
  },

