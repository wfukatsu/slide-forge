{
  "schemaVersion": 1,
  "id": "aggregate-canvas",
  "displayName": "集約の境界と不変条件",
  "pack": "nexus",
  "category": "design",
  "description": "1 つの集約が含む構成要素と、守り続ける不変条件を、確かめる例と一緒に示す",
  "answers": [
    "この集約はどこまでを含み、どの不変条件を守るのか"
  ],
  "inferenceLevel": "descriptive",
  "compatibleLayouts": [
    "BLANK"
  ],
  "example": "example.json",
  "slots": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": {
        "$density": {
          "print": 38,
          "presentation": 30
        }
      }
    },
    "lead": {
      "type": "string",
      "required": true,
      "maxLength": {
        "$density": {
          "print": 140,
          "presentation": 100
        }
      }
    },
    "members": {
      "type": "string[][]",
      "required": true,
      "minItems": 2,
      "maxItems": {
        "$density": {
          "print": 4,
          "presentation": 3
        }
      },
      "maxLength": {
        "$density": {
          "print": 22,
          "presentation": 16
        }
      },
      "items": {
        "type": "string[]",
        "minItems": 3,
        "maxItems": 3
      }
    },
    "invariants": {
      "type": "string[][]",
      "required": true,
      "minItems": 2,
      "maxItems": {
        "$density": {
          "print": 4,
          "presentation": 3
        }
      },
      "maxLength": {
        "$density": {
          "print": 24,
          "presentation": 18
        }
      },
      "items": {
        "type": "string[]",
        "minItems": 3,
        "maxItems": 3
      }
    },
    "examples": {
      "type": "array",
      "required": true,
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "tuple",
        "fields": [
          {
            "type": "string",
            "maxLength": 18
          },
          {
            "type": "string",
            "maxLength": {
              "$density": {
                "print": 46,
                "presentation": 34
              }
            }
          }
        ]
      }
    },
    "source": {
      "type": "string",
      "required": true,
      "maxLength": 170
    }
  },
  "guardrails": [
    "境界の外にあるものを構成要素に含めない。参照だけなら種別に『参照』と書く",
    "不変条件は『常に真であること』だけを書く。手順や業務ルールの説明はここに置かない",
    "違反する操作の欄を空にしない。何が破るのか分からない不変条件は検証できない",
    "1 ページ 1 集約。集約間の関係は context-map か state-machine-matrix で示す"
  ],
  "slide": {
    "layout": "BLANK",
    "figures": [
      {
        "type": "governing_message",
        "x": 0.5,
        "y": 0.42,
        "w": 9.0,
        "text": {
          "$slot": "title"
        }
      },
      {
        "type": "lead_in",
        "x": 0.5,
        "y": 1.02,
        "w": 9.0,
        "text": {
          "$slot": "lead"
        }
      },
      {
        "type": "table",
        "x": 0.5,
        "y": 1.6,
        "w": 4.3,
        "headers": [
          "構成要素",
          "種別",
          "同一性・検証"
        ],
        "rows": {
          "$slot": "members"
        },
        "size": {
          "$density": {
            "print": 9,
            "presentation": 10.5
          }
        },
        "row_h": {
          "$density": {
            "print": 0.34,
            "presentation": 0.4
          }
        },
        "header_h": 0.36,
        "col_widths": [
          1.5,
          0.9,
          1.9
        ],
        "aligns": [
          "START",
          "CENTER",
          "START"
        ],
        "textMargin": {
          "$density": {
            "print": 0.02,
            "presentation": 0.04
          }
        }
      },
      {
        "type": "table",
        "x": 5.2,
        "y": 1.6,
        "w": 4.3,
        "headers": [
          "ID",
          "不変条件",
          "違反する操作"
        ],
        "rows": {
          "$slot": "invariants"
        },
        "size": {
          "$density": {
            "print": 9,
            "presentation": 10.5
          }
        },
        "row_h": {
          "$density": {
            "print": 0.34,
            "presentation": 0.4
          }
        },
        "header_h": 0.36,
        "col_widths": [
          0.7,
          2.1,
          1.5
        ],
        "aligns": [
          "START",
          "START",
          "START"
        ],
        "textMargin": {
          "$density": {
            "print": 0.02,
            "presentation": 0.04
          }
        }
      },
      {
        "type": "cards",
        "x": 0.5,
        "y": 3.66,
        "w": 9.0,
        "h": 0.9,
        "items": {
          "$slot": "examples"
        },
        "title_size": {
          "$density": {
            "print": 10,
            "presentation": 11
          }
        },
        "body_size": {
          "$density": {
            "print": 8.5,
            "presentation": 9.5
          }
        }
      },
      {
        "type": "source_note",
        "x": 0.5,
        "y": 4.87,
        "w": 9.0,
        "source": {
          "$slot": "source"
        }
      }
    ]
  },
  "defaultDensity": "print",
  "examples": {
    "print": "example.json",
    "presentation": "example.presentation.json"
  }
}
