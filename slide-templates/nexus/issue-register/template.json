{
  "schemaVersion": 1,
  "id": "issue-register",
  "displayName": "課題・負債・指摘の一覧",
  "pack": "nexus",
  "category": "findings",
  "description": "検出された課題を重大度の分布と個票で示す",
  "answers": [
    "何が、どれくらいまずい状態で見つかっているのか"
  ],
  "inferenceLevel": "diagnostic",
  "compatibleLayouts": [
    "BLANK"
  ],
  "example": "example.json",
  "slots": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": {
        "$density": {
          "print": 38,
          "presentation": 30
        }
      }
    },
    "lead": {
      "type": "string",
      "required": true,
      "maxLength": {
        "$density": {
          "print": 140,
          "presentation": 100
        }
      }
    },
    "counts": {
      "type": "array",
      "items": {
        "type": "tuple",
        "fields": [
          {
            "type": "string",
            "maxLength": 12
          },
          {
            "type": "number",
            "minimum": 0
          },
          {
            "type": "string",
            "maxLength": 8
          }
        ]
      },
      "required": true,
      "minItems": 2,
      "maxItems": 4
    },
    "issues": {
      "type": "string[][]",
      "required": true,
      "minItems": 2,
      "maxItems": {
        "$density": {
          "print": 7,
          "presentation": 5
        }
      },
      "maxLength": {
        "$density": {
          "print": 24,
          "presentation": 18
        }
      },
      "items": {
        "type": "string[]",
        "minItems": 3,
        "maxItems": 3
      }
    },
    "source": {
      "type": "string",
      "required": true,
      "maxLength": 170
    }
  },
  "guardrails": [
    "重大度はレポートが付けた値をそのまま使う。デッキ側で上げ下げしない",
    "counts の合計と issues の総数は一致させる（抜粋するなら lead でそう書く）",
    "打ち手はこのページに書かない。ここは『何が見つかったか』まで",
    "個票には根拠（ファイル名・行・エンドポイント）を必ず残す"
  ],
  "slide": {
    "layout": "BLANK",
    "figures": [
      {
        "type": "governing_message",
        "x": 0.5,
        "y": 0.42,
        "w": 9.0,
        "text": {
          "$slot": "title"
        }
      },
      {
        "type": "lead_in",
        "x": 0.5,
        "y": 1.02,
        "w": 9.0,
        "text": {
          "$slot": "lead"
        }
      },
      {
        "type": "hbars",
        "x": 0.5,
        "y": 1.62,
        "w": 3.1,
        "items": {
          "$slot": "counts"
        },
        "label_w": 1.3,
        "value_w": 0.7,
        "row_h": 0.42,
        "gap": 0.16
      },
      {
        "type": "table",
        "x": 3.9,
        "y": 1.62,
        "w": 5.6,
        "headers": [
          "重大度",
          "課題",
          "根拠"
        ],
        "rows": {
          "$slot": "issues"
        },
        "size": {
          "$density": {
            "print": 9,
            "presentation": 10
          }
        },
        "row_h": {
          "$density": {
            "print": 0.31,
            "presentation": 0.38
          }
        },
        "col_widths": [
          0.8,
          2.0,
          2.0
        ],
        "textMargin": {
          "$density": {
            "print": 0.02,
            "presentation": 0.04
          }
        }
      },
      {
        "type": "source_note",
        "x": 0.5,
        "y": 4.87,
        "w": 9.0,
        "source": {
          "$slot": "source"
        }
      }
    ]
  },
  "defaultDensity": "print",
  "examples": {
    "print": "example.json",
    "presentation": "example.presentation.json"
  }
}
