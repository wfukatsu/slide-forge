{
  "schemaVersion": 1,
  "id": "example-map-wall",
  "displayName": "Example Mapping（規則・例・未決）",
  "pack": "nexus",
  "category": "spec",
  "description": "1 つの機能について、守るべき規則と確かめる具体例、決まらなかった問いを分けて示す",
  "answers": [
    "この機能はどの規則で動き、どの例で確かめ、何が未決なのか"
  ],
  "inferenceLevel": "descriptive",
  "compatibleLayouts": [
    "BLANK"
  ],
  "example": "example.json",
  "slots": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": {
        "$density": {
          "print": 38,
          "presentation": 30
        }
      }
    },
    "lead": {
      "type": "string",
      "required": true,
      "maxLength": {
        "$density": {
          "print": 140,
          "presentation": 100
        }
      }
    },
    "rules": {
      "type": "string[][]",
      "required": true,
      "minItems": 2,
      "maxItems": {
        "$density": {
          "print": 4,
          "presentation": 3
        }
      },
      "maxLength": {
        "$density": {
          "print": 30,
          "presentation": 22
        }
      },
      "items": {
        "type": "string[]",
        "minItems": 2,
        "maxItems": 2
      }
    },
    "examples": {
      "type": "string[][]",
      "required": true,
      "minItems": 2,
      "maxItems": {
        "$density": {
          "print": 4,
          "presentation": 3
        }
      },
      "maxLength": {
        "$density": {
          "print": 24,
          "presentation": 18
        }
      },
      "items": {
        "type": "string[]",
        "minItems": 3,
        "maxItems": 3
      }
    },
    "questions": {
      "type": "array",
      "required": true,
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "tuple",
        "fields": [
          {
            "type": "string",
            "maxLength": 18
          },
          {
            "type": "string",
            "maxLength": {
              "$density": {
                "print": 46,
                "presentation": 34
              }
            }
          }
        ]
      }
    },
    "source": {
      "type": "string",
      "required": true,
      "maxLength": 170
    }
  },
  "guardrails": [
    "規則と例を混ぜない。規則は『常に成り立つこと』、例は『それを確かめる 1 ケース』",
    "肯定例だけを載せない。境界の外側を示す否定例が 1 つ以上ないと、規則は確かめられていない",
    "未決の問いを落とさない。決まらなかったことを消すと、決まったように見える",
    "規則が上限を超える機能は分割の検討対象。載せきれなかった規則の件数を source に書く"
  ],
  "slide": {
    "layout": "BLANK",
    "figures": [
      {
        "type": "governing_message",
        "x": 0.5,
        "y": 0.42,
        "w": 9.0,
        "text": {
          "$slot": "title"
        }
      },
      {
        "type": "lead_in",
        "x": 0.5,
        "y": 1.02,
        "w": 9.0,
        "text": {
          "$slot": "lead"
        }
      },
      {
        "type": "table",
        "x": 0.5,
        "y": 1.6,
        "w": 4.3,
        "headers": [
          "RULE",
          "守るべき規則"
        ],
        "rows": {
          "$slot": "rules"
        },
        "size": {
          "$density": {
            "print": 9,
            "presentation": 10.5
          }
        },
        "row_h": {
          "$density": {
            "print": 0.34,
            "presentation": 0.4
          }
        },
        "header_h": 0.36,
        "col_widths": [
          0.9,
          3.4
        ],
        "aligns": [
          "START",
          "START"
        ],
        "textMargin": {
          "$density": {
            "print": 0.02,
            "presentation": 0.04
          }
        }
      },
      {
        "type": "table",
        "x": 5.2,
        "y": 1.6,
        "w": 4.3,
        "headers": [
          "EX",
          "種別",
          "確かめる例"
        ],
        "rows": {
          "$slot": "examples"
        },
        "size": {
          "$density": {
            "print": 9,
            "presentation": 10.5
          }
        },
        "row_h": {
          "$density": {
            "print": 0.34,
            "presentation": 0.4
          }
        },
        "header_h": 0.36,
        "col_widths": [
          0.8,
          0.9,
          2.6
        ],
        "aligns": [
          "START",
          "CENTER",
          "START"
        ],
        "textMargin": {
          "$density": {
            "print": 0.02,
            "presentation": 0.04
          }
        }
      },
      {
        "type": "cards",
        "x": 0.5,
        "y": 3.66,
        "w": 9.0,
        "h": 0.9,
        "items": {
          "$slot": "questions"
        },
        "title_size": {
          "$density": {
            "print": 10,
            "presentation": 11
          }
        },
        "body_size": {
          "$density": {
            "print": 8.5,
            "presentation": 9.5
          }
        }
      },
      {
        "type": "source_note",
        "x": 0.5,
        "y": 4.87,
        "w": 9.0,
        "source": {
          "$slot": "source"
        }
      }
    ]
  },
  "defaultDensity": "print",
  "examples": {
    "print": "example.json",
    "presentation": "example.presentation.json"
  }
}
