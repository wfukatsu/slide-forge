{
  "schemaVersion": 1,
  "id": "bounded-context-canvas",
  "displayName": "境界づけられたコンテキスト",
  "pack": "nexus",
  "category": "design",
  "description": "1 つの境界づけられたコンテキストを 9 区画のキャンバスで示し、担う責務と境界の外側を確定させる",
  "answers": [
    "このコンテキストは何を担い、どこまでが境界か"
  ],
  "inferenceLevel": "descriptive",
  "compatibleLayouts": [
    "BLANK"
  ],
  "example": "example.json",
  "slots": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": {
        "$density": {
          "print": 38,
          "presentation": 30
        }
      }
    },
    "lead": {
      "type": "string",
      "required": true,
      "maxLength": {
        "$density": {
          "print": 140,
          "presentation": 100
        }
      }
    },
    "purpose": {
      "type": "string",
      "required": true,
      "maxLength": {
        "$density": {
          "print": 54,
          "presentation": 38
        }
      }
    },
    "classification": {
      "type": "string",
      "required": true,
      "maxLength": {
        "$density": {
          "print": 54,
          "presentation": 38
        }
      }
    },
    "evolution": {
      "type": "string",
      "required": true,
      "maxLength": {
        "$density": {
          "print": 54,
          "presentation": 38
        }
      }
    },
    "domainRoles": {
      "type": "string",
      "required": true,
      "maxLength": {
        "$density": {
          "print": 54,
          "presentation": 38
        }
      }
    },
    "inbound": {
      "type": "string",
      "required": true,
      "maxLength": {
        "$density": {
          "print": 54,
          "presentation": 38
        }
      }
    },
    "outbound": {
      "type": "string",
      "required": true,
      "maxLength": {
        "$density": {
          "print": 54,
          "presentation": 38
        }
      }
    },
    "language": {
      "type": "string",
      "required": true,
      "maxLength": {
        "$density": {
          "print": 54,
          "presentation": 38
        }
      }
    },
    "decisions": {
      "type": "string",
      "required": true,
      "maxLength": {
        "$density": {
          "print": 54,
          "presentation": 38
        }
      }
    },
    "assumptions": {
      "type": "string",
      "required": true,
      "maxLength": {
        "$density": {
          "print": 54,
          "presentation": 38
        }
      }
    },
    "source": {
      "type": "string",
      "required": true,
      "maxLength": 170
    }
  },
  "guardrails": [
    "Core / Supporting / Generic の区分はレポートの記述をそのまま使う。スライド上で格上げ・格下げしない",
    "未確定は『前提と未解決』に残す。空欄にすると確定済みに見える",
    "受信・発信には相手のコンテキスト名を必ず書く。パターン名（ACL・OHS）だけでは関係が復元できない",
    "1 ページ 1 コンテキスト。複数を並べたくなったら context-map を使う"
  ],
  "slide": {
    "layout": "BLANK",
    "figures": [
      {
        "type": "governing_message",
        "x": 0.5,
        "y": 0.42,
        "w": 9.0,
        "text": {
          "$slot": "title"
        }
      },
      {
        "type": "lead_in",
        "x": 0.5,
        "y": 1.02,
        "w": 9.0,
        "text": {
          "$slot": "lead"
        }
      },
      {
        "type": "cards",
        "x": 0.5,
        "y": 1.6,
        "w": 9.0,
        "h": 0.98,
        "items": [
          [
            "目的",
            {
              "$slot": "purpose"
            }
          ],
          [
            "戦略分類",
            {
              "$slot": "classification"
            }
          ],
          [
            "進化段階",
            {
              "$slot": "evolution"
            }
          ]
        ],
        "title_size": {
          "$density": {
            "print": 10,
            "presentation": 11
          }
        },
        "body_size": {
          "$density": {
            "print": 8.5,
            "presentation": 9.5
          }
        }
      },
      {
        "type": "cards",
        "x": 0.5,
        "y": 2.68,
        "w": 9.0,
        "h": 0.98,
        "items": [
          [
            "ドメインロール",
            {
              "$slot": "domainRoles"
            }
          ],
          [
            "受信 Inbound",
            {
              "$slot": "inbound"
            }
          ],
          [
            "発信 Outbound",
            {
              "$slot": "outbound"
            }
          ]
        ],
        "title_size": {
          "$density": {
            "print": 10,
            "presentation": 11
          }
        },
        "body_size": {
          "$density": {
            "print": 8.5,
            "presentation": 9.5
          }
        }
      },
      {
        "type": "cards",
        "x": 0.5,
        "y": 3.74,
        "w": 9.0,
        "h": 0.98,
        "items": [
          [
            "ユビキタス言語",
            {
              "$slot": "language"
            }
          ],
          [
            "業務上の判断",
            {
              "$slot": "decisions"
            }
          ],
          [
            "前提と未解決",
            {
              "$slot": "assumptions"
            }
          ]
        ],
        "title_size": {
          "$density": {
            "print": 10,
            "presentation": 11
          }
        },
        "body_size": {
          "$density": {
            "print": 8.5,
            "presentation": 9.5
          }
        }
      },
      {
        "type": "source_note",
        "x": 0.5,
        "y": 4.87,
        "w": 9.0,
        "source": {
          "$slot": "source"
        }
      }
    ]
  },
  "defaultDensity": "print",
  "examples": {
    "print": "example.json",
    "presentation": "example.presentation.json"
  }
}
