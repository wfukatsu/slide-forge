{
  "schemaVersion": 1,
  "id": "ui-mock-detail",
  "displayName": "画面詳細（UI モック 1 枚）",
  "pack": "nexus",
  "category": "product",
  "description": "1 画面のモックを大きく見せ、注目点と仕様を並べる",
  "answers": [
    "この画面で何が決まっているのか"
  ],
  "inferenceLevel": "descriptive",
  "compatibleLayouts": [
    "BLANK"
  ],
  "example": "example.json",
  "slots": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": {
        "$density": {
          "print": 38,
          "presentation": 30
        }
      }
    },
    "screen": {
      "type": "string",
      "required": true,
      "maxLength": {
        "$density": {
          "print": 140,
          "presentation": 100
        }
      }
    },
    "shot": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "notes": {
      "type": "string[][]",
      "required": true,
      "minItems": 2,
      "maxItems": {
        "$density": {
          "print": 6,
          "presentation": 4
        }
      },
      "maxLength": {
        "$density": {
          "print": 18,
          "presentation": 14
        }
      },
      "items": {
        "type": "string[]",
        "minItems": 2,
        "maxItems": 2
      }
    },
    "source": {
      "type": "string",
      "required": true,
      "maxLength": 170
    }
  },
  "guardrails": [
    "注目点は画面上に見えていることだけ。裏の処理仕様はこのページに書かない",
    "画像は scripts/html_shot.py で撮り、Read で目視確認してから貼る",
    "未確定の要素は表側に『未確定』と書く。モックに描いてあることを確定事項として説明しない"
  ],
  "slide": {
    "layout": "BLANK",
    "figures": [
      {
        "type": "governing_message",
        "x": 0.5,
        "y": 0.42,
        "w": 9.0,
        "text": {
          "$slot": "title"
        }
      },
      {
        "type": "lead_in",
        "x": 0.5,
        "y": 1.02,
        "w": 9.0,
        "text": {
          "$slot": "screen"
        }
      },
      {
        "type": "image",
        "x": 0.5,
        "y": 1.55,
        "w": 5.6,
        "h": 3.1,
        "source": {
          "$slot": "shot"
        },
        "fit": "contain"
      },
      {
        "type": "table",
        "x": 6.3,
        "y": 1.55,
        "w": 3.2,
        "headers": [
          "注目点",
          "内容"
        ],
        "rows": {
          "$slot": "notes"
        },
        "col_widths": [
          1.0,
          1.5
        ],
        "size": {
          "$density": {
            "print": 9,
            "presentation": 10
          }
        },
        "row_h": {
          "$density": {
            "print": 0.33,
            "presentation": 0.4
          }
        },
        "textMargin": {
          "$density": {
            "print": 0.02,
            "presentation": 0.04
          }
        }
      },
      {
        "type": "source_note",
        "x": 0.5,
        "y": 4.87,
        "w": 9.0,
        "source": {
          "$slot": "source"
        }
      }
    ]
  },
  "defaultDensity": "print"
}
