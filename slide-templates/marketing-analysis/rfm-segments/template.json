{
  "schemaVersion": 1,
  "id": "rfm-segments",
  "displayName": "RFMセグメント",
  "pack": "marketing-analysis",
  "category": "customer",
  "description": "購買の最新性・頻度・金額から顧客群と施策を比較する",
  "answers": ["優良・育成・休眠顧客は誰で、どの施策を行うか"],
  "inferenceLevel": "diagnostic",
  "compatibleLayouts": ["BLANK"],
  "example": "example.json",
  "slots": {
    "title": {"type": "string", "required": true, "maxLength": 70},
    "rows": {"type": "string[][]", "required": true, "minItems": 3, "maxItems": 7, "maxLength": 44},
    "insight": {"type": "string", "required": true, "maxLength": 120},
    "source": {"type": "string", "required": true, "maxLength": 160}
  },
  "slide": {
    "layout": "BLANK",
    "figures": [
      {"type": "governing_message", "x": 0.5, "y": 0.42, "w": 9.0, "text": {"$slot": "title"}},
      {"type": "table", "x": 0.5, "y": 1.15, "w": 6.1, "headers": ["セグメント", "R", "F", "M", "推奨施策"], "rows": {"$slot": "rows"}, "colWidths": [1.5, 0.55, 0.55, 0.55, 2.5], "size": 8.8, "rowH": 0.46},
      {"type": "so_what", "x": 6.8, "y": 1.3, "w": 2.65, "h": 2.95, "text": {"$slot": "insight"}},
      {"type": "source_note", "x": 0.5, "y": 4.85, "w": 9.0, "source": {"$slot": "source"}}
    ]
  }
}
