{
  "schemaVersion": 1,
  "id": "positioning-map",
  "displayName": "ポジショニングマップ",
  "pack": "marketing-analysis",
  "category": "strategic",
  "description": "2軸上で自社と競合の位置関係を示す",
  "answers": ["自社は競合と異なる価値を提供できているか"],
  "inferenceLevel": "diagnostic",
  "compatibleLayouts": ["BLANK"],
  "example": "example.json",
  "slots": {
    "title": {"type": "string", "required": true, "maxLength": 70},
    "points": {"type": "array", "required": true, "minItems": 2, "maxItems": 8,
               "items": {"type": "tuple", "fields": [
                 {"type": "string", "maxLength": 24},
                 {"type": "number", "minimum": 0, "maximum": 1},
                 {"type": "number", "minimum": 0, "maximum": 1}]}},
    "xAxis": {"type": "string[]", "required": true, "minItems": 2, "maxItems": 2, "maxLength": 24},
    "yAxis": {"type": "string[]", "required": true, "minItems": 2, "maxItems": 2, "maxLength": 24},
    "highlight": {"type": "string", "required": true, "maxLength": 20},
    "insight": {"type": "string", "required": true, "maxLength": 120},
    "source": {"type": "string", "required": true, "maxLength": 160}
  },
  "slide": {
    "layout": "BLANK",
    "figures": [
      {"type": "governing_message", "x": 0.5, "y": 0.42, "w": 9.0, "text": {"$slot": "title"}},
      {"type": "posmap", "x": 0.55, "y": 1.1, "w": 6.2, "h": 3.55, "points": {"$slot": "points"}, "xAxis": {"$slot": "xAxis"}, "yAxis": {"$slot": "yAxis"}, "highlight": {"$slot": "highlight"}},
      {"type": "so_what", "x": 6.9, "y": 1.25, "w": 2.55, "h": 3.1, "text": {"$slot": "insight"}},
      {"type": "source_note", "x": 0.5, "y": 4.85, "w": 9.0, "source": {"$slot": "source"}}
    ]
  }
}
