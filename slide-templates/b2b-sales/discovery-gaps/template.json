    "discovery-map の missing / wip と対応させること"
  ],
  "slide": {
    "layout": "BLANK",
    "figures": [
      {"type": "governing_message", "x": 0.5, "y": 0.42, "w": 9.0, "text": {"$slot": "title"}},
      {"type": "lead_in", "x": 0.5, "y": 1.0, "w": 9.0, "text": {"$slot": "lead"}},
      {"type": "table", "x": 0.5, "y": 1.6, "w": 9.0,
       "headers": ["未確認事項", "なぜ重要か", "確認相手", "期限"],
