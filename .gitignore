# Python
__pycache__/
*.py[cod]
.venv

# OAuth credentials — never commit.
# Ignore the contents, not the directory itself: `config/` would stop git
# descending and the !config/.gitkeep negation below could never match.
config/*
!config/.gitkeep
**/credentials.json
**/token.json
**/token.json.bak*

# Per-customer sales ledgers (scalar-account-plan). Named individuals and
# judgements about them — never committed. The worked example lives in
# examples/account-sample.json and uses a fictional account.
accounts/

# Transient render caches and QA output
cache/*
!cache/.gitkeep
out/*
!out/.gitkeep

# Vendor cloud icons — not redistributed; restore with scripts/fetch_cloud_icons.py
assets/cloud-icons/*
!assets/cloud-icons/README.md

# Local scratch space for brand icon work — never published
assets/shared-brand-icons-tmp/

# Generated locally during Setup, not committed — see README "Setup".
# Slide masters (.pptx, ~7MB each): scripts/export_template_master.py, or build
# your own with template-forge. Pattern catalog images (~2MB):
# scripts/build_pattern_catalog.py.
templates/masters/*
!templates/masters/README.md
references/images/slide-patterns/*
!references/images/slide-patterns/.gitkeep

# macOS
.DS_Store
